      "text": [
        "Januari 2026."
      ],
      "startFrame": 8,
      "durationInFrames": 45,
      "segment": "vo01"
    },
    {
      "text": [
        "Jam makan siang di sebuah SMA di Kudus,"
      ],
      "startFrame": 53,
      "durationInFrames": 134,
      "segment": "vo01"
    },
    {
      "text": [
        "ratusan siswa dilarikan ke rumah sakit."
      ],
      "startFrame": 187,
      "durationInFrames": 134,
      "segment": "vo01"
    },
    {
      "text": [
        "Makan Bergizi Gratis sudah berjalan"
      ],
      "startFrame": 411,
      "durationInFrames": 101,
      "segment": "vo02"
    },
    {
      "text": [
        "sejak Januari 2025."
      ],
      "startFrame": 512,
      "durationInFrames": 55,
      "segment": "vo02"
    },
    {
      "text": [
        "Anggarannya naik dari Rp71 triliun,"
      ],
      "startFrame": 567,
      "durationInFrames": 101,
      "segment": "vo02"
    },
    {
      "text": [
        "jadi Rp268 triliun tahun ini."
      ],
      "startFrame": 668,
      "durationInFrames": 82,
      "segment": "vo02"
    },
    {
      "text": [
        "September 2025, pemerintah menyebut"
      ],
      "startFrame": 768,
      "durationInFrames": 126,
      "segment": "vo03"
    },
    {
      "text": [
        "keracunan cuma 0,0017 persen."
      ],
      "startFrame": 894,
      "durationInFrames": 105,
      "segment": "vo03"
    },
    {
      "text": [
        "Kecil."
      ],
      "startFrame": 999,
      "durationInFrames": 34,
      "segment": "vo03"
    },
    {
      "text": [
        "Tapi sampai Mei 2026, JPPI mencatat"
      ],
      "startFrame": 1033,
      "durationInFrames": 114,
      "segment": "vo03"
    },
    {
      "text": [
        "lebih dari 37 ribu siswa."
      ],
      "startFrame": 1147,
      "durationInFrames": 90,
      "segment": "vo03"
    },
    {
      "text": [
        "Menurut Ombudsman Sumatera Utara:",
        "sertifikatnya lengkap,"
      ],
      "startFrame": 1363,
      "durationInFrames": 121,
      "segment": "vo04"
    },
    {
      "text": [
        "pengawasannya yang tidak sampai ke dapur."
      ],
      "startFrame": 1484,
      "durationInFrames": 88,
      "segment": "vo04"
    },
    {
      "text": [
        "Guru sekarang diminta mencicipi dulu"
      ],
      "startFrame": 1648,
      "durationInFrames": 92,
      "segment": "vo05"
    },
    {
      "text": [
        "sebelum anak-anak makan."
      ],
      "startFrame": 1740,
      "durationInFrames": 61,
      "segment": "vo05"
    },
    {
      "text": [
        "Setiap ada kasus, responsnya sama:"
      ],
      "startFrame": 1801,
      "durationInFrames": 87,
      "segment": "vo05"
    },
    {
      "text": [
        "tutup, minta maaf, buka lagi."
      ],
      "startFrame": 1888,
      "durationInFrames": 74,
      "segment": "vo05"
    },
    {
      "text": [
        "Jadi bukan nasinya yang salah."
      ],
      "startFrame": 1980,
      "durationInFrames": 75,
      "segment": "vo06"
    },
    {
      "text": [
        "Yang salah cara kita mengukur berhasil:"
      ],
      "startFrame": 2055,
      "durationInFrames": 97,
      "segment": "vo06"
    },
    {
      "text": [
        "dari jumlah piring yang terkirim,"
      ],
      "startFrame": 2152,
      "durationInFrames": 82,
      "segment": "vo06"
    },
    {
      "text": [
        "bukan dari anak yang pulang selamat."
      ],
      "startFrame": 2234,
      "durationInFrames": 90,
      "segment": "vo06"
    },
    {
      "text": [
        "Kalau sertifikat lengkap, anggaran besar,"
      ],
      "startFrame": 2341,
      "durationInFrames": 101,
      "segment": "vo07"
    },
    {
      "text": [
        "dan laporan rapi belum bisa"
      ],
      "startFrame": 2442,
      "durationInFrames": 67,
      "segment": "vo07"
    },
    {
      "text": [
        "menjaga satu anak tetap aman,"
      ],
      "startFrame": 2509,
      "durationInFrames": 72,
      "segment": "vo07"
    },
    {
      "text": [
        "apa yang sedang kita bangun?"
