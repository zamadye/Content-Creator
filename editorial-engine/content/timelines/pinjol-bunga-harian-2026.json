  "captions": [
    {
      "text": [
        "Kalau ada pinjaman",
        "bunga 0,3% per hari."
      ],
      "startFrame": 5,
      "durationInFrames": 123,
      "segment": "vo01"
    },
    {
      "text": [
        "Kelihatan kecil, kan?"
      ],
      "startFrame": 128,
      "durationInFrames": 66,
      "segment": "vo01"
    },
    {
      "text": [
        "Itu karena kamu",
        "cuma melihat sehari."
      ],
      "startFrame": 194,
      "durationInFrames": 113,
      "segment": "vo01"
    },
    {
      "text": [
        "Pinjam Rp1 juta,",
        "tenor 30 hari."
      ],
      "startFrame": 317,
      "durationInFrames": 117,
      "segment": "vo02"
    },
    {
      "text": [
        "Bunga Rp3.000",
        "per hari."
      ],
      "startFrame": 434,
      "durationInFrames": 87,
      "segment": "vo02"
    },
    {
      "text": [
        "30 hari: Rp90.000."
      ],
      "startFrame": 521,
      "durationInFrames": 68,
      "segment": "vo02"
    },
    {
      "text": [
        "Masih masuk akal."
      ],
      "startFrame": 589,
      "durationInFrames": 64,
      "segment": "vo02"
    },
    {
      "text": [
        "Tapi 30 hari",
        "bukan janji."
      ],
      "startFrame": 664,
      "durationInFrames": 66,
      "segment": "vo03"
    },
    {
      "text": [
        "Telat sehari:",
        "denda di atas bunga."
      ],
      "startFrame": 730,
      "durationInFrames": 90,
      "segment": "vo03"
    },
    {
      "text": [
        "Bunga tetap jalan."
      ],
      "startFrame": 820,
      "durationInFrames": 48,
      "segment": "vo03"
    },
    {
      "text": [
        "Pokok belum tentu turun."
      ],
      "startFrame": 868,
      "durationInFrames": 63,
      "segment": "vo03"
    },
    {
      "text": [
        "Sekarang hitung",
        "setahun, bukan sehari."
      ],
      "startFrame": 964,
      "durationInFrames": 188,
      "segment": "vo04"
    },
    {
      "text": [
        "0,3% × 365",
