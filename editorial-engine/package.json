{
  "name": "@editorial/engine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "KNOT THEORY — private-input Dunia Kebalik production examples and safety tests",
  "scripts": {
    "fonts": "node pipeline/prepare-fonts.mjs",
    "build:hiu": "bash pipeline/hiu-sebelum-hutan-2026/build.sh",
    "build:teleskop": "bash pipeline/teleskop-2026-11-12/build.sh",
    "build:antartika": "bash pipeline/interactive-antartika-v2/build.sh",
    "test": "node --test pipeline/tests/*.test.mjs pipeline/schedule-shark-1900/test-runner.mjs pipeline/publish-antartika/test-runner.mjs pipeline/coverr-transfer/test-transfer.mjs pipeline/drive-relay/test-relay.mjs",
    "test:python": "python3 -m unittest pipeline/test_coverr_search.py pipeline/coverr-transfer/test-search-hq.py",
    "build:awan": "bash pipeline/awan-500-ton-2026/build.sh",
    "build:awan-rig-v2": "bash pipeline/awan-rig-v2/build.sh",
    "build:awan-rig-v3": "bash pipeline/awan-rig-v3/build.sh",
    "build:kaca-rupert": "bash pipeline/kaca-rupert-visual-v1/build.sh",
    "test:story": "python3 pipeline/story-engine/test_story_gate.py && python3 pipeline/script-review/test-audit.py"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@fontsource/archivo": "^5.2.5",
    "@fontsource/instrument-serif": "^5.2.5",
    "@fontsource/permanent-marker": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "^4.0.380",
    "wawoff2": "^2.0.1"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.380",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
