{
  "name": "knot-theory-content-studio",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.18.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "scripts": {
    "test": "corepack pnpm -r --if-present test",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "lint": "corepack pnpm -r --if-present lint",
    "build": "corepack pnpm -r --if-present build",
    "api:dev": "corepack pnpm --filter @content-studio/api dev",
    "db:validate": "corepack pnpm --filter @content-studio/db db:validate",
    "db:generate": "corepack pnpm --filter @content-studio/db db:generate",
    "db:migrate": "corepack pnpm --filter @content-studio/db db:migrate",
    "dev": "corepack pnpm --filter @content-studio/db build && concurrently --kill-others-on-fail \"corepack pnpm --filter @content-studio/api dev\" \"corepack pnpm --filter @content-studio/web dev\""
  },
  "devDependencies": {
    "concurrently": "9.2.1"
  }
}
