  "cast": {
    "alya": {
      "asset": "char.remaja-perempuan",
      "label": "Alya",
      "note": "20 th, mahasiswa Desain semester 4, anak rantau dari Banjarmasin, barista paruh waktu. Persona: sarkas, cepat, gengsi tinggi, pantang ngutang; kalau panik justru makin banyak ngomong. Bahasa: 'gak', 'banget', 'sumpah', 'relate', 'btw'."
    },
    "bima": {
      "asset": "char.male-muda-jaket",
      "label": "Bima",
      "note": "23 th, kakak tingkat, wajah baik, brand ambassador kampus. Persona: kalem, memakai diksi moral ('kita kan keluarga'), gemar menolong di depan orang banyak. Di balik itu: transaksional dan dingin. Bahasa: 'kamu tuh', 'santai', 'ada aku'."
    },
    "nadin": {
      "asset": "char.female-dewasa",
      "label": "Nadin",
      "note": "21 th, teman sekamar Alya, pembuat konten kecil-kecilan. Persona: ceria di depan, haus validasi, mudah ikut arus demi view. Bahasa: 'bestie', 'fyp', 'aesthetic', 'jangan marah ya'."
    },
    "ratna": {
      "asset": "char.female-dewasa-daster",
      "label": "Bu Ratna",
      "note": "48 th, pemilik kos. Persona: jutek, to-the-point, tapi adil; tidak suka drama, sangat menghormati bukti. Bahasa: datar, tanpa gaul, memanggil 'Nak'."
    },
    "ibu": {
      "asset": "char.female-lansia",
      "label": "Ibu",
      "note": "62 th, ibu Alya di Banjarmasin, sakit lutut, tidak tahu kondisi keuangan anaknya. Persona: hangat, banyak menyembunyikan rasa sakit. Hanya muncul di panggilan video."
    }
  },
