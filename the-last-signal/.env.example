# --- Database & queue (Phase 3/4) -------------------------------------------
DATABASE_URL="postgresql://tls:tls_dev_password@localhost:5432/the_last_signal?schema=public"
REDIS_URL="redis://localhost:6379"

# --- Render ------------------------------------------------------------------
# Path Chromium/Chrome Headless Shell. Kosongkan untuk memakai unduhan Remotion.
# Di server Linux minimal, pakai browser sistem agar tidak perlu unduh:
#   REMOTION_BROWSER_EXECUTABLE=/usr/bin/chromium
REMOTION_BROWSER_EXECUTABLE=

# --- AI providers (Phase 3, belum dipakai kode) ------------------------------
# Isi hanya kalau memang akan memanggil provider dari pipeline.
IMAGE_PROVIDER=
IMAGE_PROVIDER_API_KEY=
TTS_PROVIDER=
TTS_PROVIDER_API_KEY=

# --- Publishing (Phase 5) ----------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
