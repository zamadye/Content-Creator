node_modules/
.pnpm-store/
*.log
.DS_Store
.env

# Build + render artefacts (large binaries, not source)
renders/
*.mp4
*.webm

# Audio prosedural (dibuat ulang oleh scripts/make-*.mjs, deterministic)
projects/episodes/*/audio/score.wav
projects/episodes/*/audio/ambience_drone.wav
projects/episodes/*/audio/sfx/*.wav

# Remotion
.remotion/

# Laporan diagnostik penerbitan (dibuat saat runtime)
report/

# Video yang diangkut ke runner Actions untuk diunggah ke Zernio
!releases/*.mp4

# Backup edit manual episode.json (lokal saja)
projects/episodes/*/episode.json.bak

# Gambar episode (puluhan berkas ~2,7 MB tiap episode). Disimpan di Drive;
# yang masuk git hanya promptnya (stories/**/image-prompts.json) dan pilihan
# kolamnya (stories/**/plan.json), jadi gambar bisa dibuat ulang.
projects/episodes/*/images/*
!projects/episodes/*/images/thumb.png
