{
  "name": "the-last-signal",
  "version": "0.1.0",
  "private": true,
  "description": "Automated found-footage horror studio for YouTube Shorts (id-ID). Phase 1: cinematic render engine.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "studio": "pnpm --filter @the-last-signal/renderer studio",
    "render": "tsx scripts/render.ts",
    "validate": "tsx scripts/validate-episode.ts",
    "audio:demo": "node scripts/make-demo-audio.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test packages/contracts/test/*.test.ts",
    "stills": "tsx scripts/stills.ts",
    "encode": "tsx scripts/encode-delivery.ts --episode LS-0001",
    "qc": "tsx scripts/qc.ts --episode LS-0001",
    "check:copy": "node scripts/check-copy.mjs",
    "test:copy": "node --test scripts/check-copy.test.mjs"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@remotion/bundler": "4.0.540",
    "@remotion/renderer": "4.0.540",
    "@sparticuz/chromium": "^131.0.1",
    "@the-last-signal/contracts": "workspace:*",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "zod": "^3.24.1"
  }
}
